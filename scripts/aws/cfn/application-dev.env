#Configuration for send notification attachment. Comma separated list made up by:
#Configuration start time (UTC);
#attachments to send for legal mail; (separated by |)
#attachments to send for personal mail; (separated by |)
#attachments to send for simple registered letter; (separated by |)
PN_WORKFLOWMANAGER_PNSENDMODE=1970-01-01T00:00:00Z;DOCUMENTS;DOCUMENTS|PAYMENTS;COVERPAGE|DOCUMENTS|PAYMENTS
# How many minutes io connector should try to poll for new messages before giving up.
PN_WORKFLOWMANAGER_IOPOLLINGMAXMINS=16
# Whether to send SMS courtesy notifications or not.
PN_WORKFLOWMANAGER_SMSCOURTESYENABLED=false
# Whether to send attachments in email courtesy notifications or not.
PN_WORKFLOWMANAGER_EMAILCOURTESYREQUIRESATTACHMENTS=false
#Intervalli di retry per i messaggi di cortesia, per canale. Interi separati da virgola che rappresentano i minuti di attesa che precedono ciascun retry. La lunghezza della lista definisce il numero di tentativi; lista vuota = nessun nuovo tentativo.
PN_WORKFLOWMANAGER_COURTESYRETRY_INTERVALSMINUTES_IO=5,10,20,40
PN_WORKFLOWMANAGER_COURTESYRETRY_INTERVALSMINUTES_SMS=1,2,4,8
PN_WORKFLOWMANAGER_COURTESYRETRY_INTERVALSMINUTES_EMAIL=1,2,4,8
PN_WORKFLOWMANAGER_COURTESYRETRY_INTERVALSMINUTES_TPP=2,4,8